#!/bin/sh
set -e

case "$1" in
    configure)
        # Load kernel modules
        modprobe nvmet 2>/dev/null || true
        modprobe nvmet-tcp 2>/dev/null || true
        
        # Add modules to load on boot
        if [ ! -f /etc/modules-load.d/abe.conf ]; then
            cat > /etc/modules-load.d/abe.conf << 'EOF'
nvmet
nvmet-tcp
EOF
        fi
        
        # Reload systemd
        systemctl daemon-reload || true
        
        echo ""
        echo "Before starting ABE (systemctl start abe), make sure you have:"
        echo "  1. an LVM volume group 'abe' (or ABE_VG / ABE_THIN_POOL in"
        echo "     /etc/default/abe naming an existing one)"
        echo "     Example: pvcreate /dev/vdb && vgcreate abe /dev/vdb"
        echo "  2. a server certificate, key and client CA at /etc/abe/{cert,key,ca}.pem"
        echo "     (or ABE_TLS_CERT / ABE_TLS_KEY / ABE_TLS_CA in /etc/default/abe);"
        echo "     see /usr/share/doc/abe/README.md, section TLS"
        echo ""
        ;;
        
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
        
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
