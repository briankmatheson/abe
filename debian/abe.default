# /etc/default/abe -- environment for abe.service (all optional)

# Volume group holding the volumes (default: abe).
#ABE_VG=abe

# Thin pool inside ABE_VG. When set, volumes are thin LVs (lvcreate -V ... -T).
#ABE_THIN_POOL=

# Address nvmet listens on (default: 0.0.0.0, every interface). The API has
# no authentication: on a multi-homed host bind this and ABE_LISTEN to one
# private address (e.g. a WireGuard underlay) rather than 0.0.0.0.
#ABE_TRADDR=0.0.0.0

# Address handed to initiators in API replies. Set this when clients live on
# other machines; 0.0.0.0 is meaningless to them.
#ABE_ADVERTISE=

# HTTP API listen address (default: 0.0.0.0:80).
#ABE_LISTEN=0.0.0.0:80

# nvmet TCP port range for exports (defaults: 44001-44999). Each export takes
# the lowest free port; /configure answers 503 when the range is full.
#ABE_PORT_MIN=44001
#ABE_PORT_MAX=44999
