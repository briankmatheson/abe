[Unit]
Description=ABE (Abe Block Exporter) - NVMe-oF Block Storage Server
Documentation=https://github.com/briankmatheson/abe
After=network-online.target lvm2-monitor.service local-fs.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/abe
ExecStart=/usr/bin/abe
Restart=always
RestartSec=5
Environment="RUST_LOG=info"

# Security hardening
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/lvm /sys/kernel/config /dev /run

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
